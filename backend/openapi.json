  "components": {
    "schemas": {
      "AssessmentRecord": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "met",
              "correction",
              "clearer_view",
              "unavailable"
            ],
            "title": "Outcome"
          },
          "explanation": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Explanation"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Evidence Ids"
          },
          "criteria": {
            "items": {
              "$ref": "#/components/schemas/CriterionResult"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Criteria"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "owner_id": {
            "type": "string",
            "title": "Owner Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "version_id": {
            "type": "string",
            "title": "Version Id"
          },
          "step_id": {
            "type": "string",
            "title": "Step Id"
          },
          "step_revision": {
            "type": "integer",
            "title": "Step Revision",
            "default": 0
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "manual_unverified": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Manual Unverified"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "outcome",
          "explanation",
          "id",
          "owner_id",
          "session_id",
          "version_id",
          "step_id",
          "latency_ms",
          "created_at"
        ],
        "title": "AssessmentRecord"
      },
      "CaptureGap": {
        "properties": {
          "timestamp_ms": {
            "type": "integer",
            "title": "Timestamp Ms"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "timestamp_ms",
          "reason"
        ],
        "title": "CaptureGap"
      },
      "CreateSession": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "teach",
              "practice"
            ],
            "title": "Mode"
          },
          "source": {
            "type": "string",
            "enum": [
              "camera",
              "screen",
              "phone"
            ],
            "title": "Source"
          },
          "lesson_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lesson Id"
          },
          "version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mode",
          "source"
        ],
        "title": "CreateSession"
      },
      "Criterion": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "mode": {
            "default": "manual",
            "enum": [
              "visual",
              "manual"
            ],
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "description"
        ],
        "title": "Criterion",
        "type": "object"
      },
      "CriterionResult": {
        "additionalProperties": false,
        "properties": {
          "criterion_id": {
            "title": "Criterion Id",
            "type": "string"
          },
          "supported": {
            "title": "Supported",
            "type": "boolean"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 4,
            "title": "Evidence Ids",
            "type": "array"
          },
          "explanation": {
            "maxLength": 1000,
            "title": "Explanation",
            "type": "string"
          }
        },
        "required": [
          "criterion_id",
          "supported",
          "explanation"
        ],
        "title": "CriterionResult",
        "type": "object"
      },
      "DraftEdit": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Revision"
          },
          "draft": {
            "$ref": "#/components/schemas/LessonDraft-Input"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision",
          "draft"
        ],
        "title": "DraftEdit"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "owner_id": {
            "type": "string",
            "title": "Owner Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "complete",
              "failed",
              "interrupted"
            ],
            "title": "State"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "lesson_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lesson Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "owner_id",
          "session_id",
          "state",
          "attempts"
        ],
        "title": "JobRecord"
      },
      "LessonDraft-Input": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "maxLength": 4000,
            "title": "Summary",
            "default": ""
          },
          "materials": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Materials"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/Step"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Steps"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/Question"
            },
            "type": "array",
            "maxItems": 15,
            "title": "Questions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title"
        ],
        "title": "LessonDraft"
      },
      "LessonDraft-Output": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "summary": {
