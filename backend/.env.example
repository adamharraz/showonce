# Copy to backend/.env. Never commit real keys. Keep the Gemini project on Free.
GEMINI_API_KEY=
FREE_TIER_CONFIRMED=false
STORAGE_MODE=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:8000
DATA_DIR=.data
PHYSICAL_OBSERVER=er2
GENERAL_MODEL=gemini-3.8-flash
GENERAL_FALLBACK_MODEL=gemini-2.5-flash
PHYSICAL_ASSESSOR=gemini-robotics-er-2-preview
ANALYSIS_INTERVAL=10
DAILY_ANALYSIS_LIMIT=120
ALLOW_LOCAL_LOGIN=true
