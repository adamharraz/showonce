# Copy to backend/.env. Never commit real keys. Keep the Gemini project on Free.
GEMINI_API_KEY=
FREE_TIER_CONFIRMED=false
STORAGE_MODE=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:8000
DATA_DIR=.data
ANALYSIS_INTERVAL=10
DAILY_ANALYSIS_LIMIT=120
ALLOW_LOCAL_LOGIN=true
# Optional hosted demo: local temporary storage with developer login disabled.
# Set DEMO_MODE=true and ALLOW_LOCAL_LOGIN=false. Anyone can choose a demo role.
DEMO_MODE=false
# Lessons use gemini-3.5-flash-lite. Explicit Live Coach uses gemini-3.8-live.
# Model identifiers are fixed in the backend; there is no model fallback.
LIVE_COACH_ENABLED=true
LIVE_COACH_SECONDS=600
# Photo-to-3D is disabled until the Modal worker, model access and zero spend limit are verified.
TWIN_ENABLED=false
TWIN_FREE_CREDITS_CONFIRMED=false
TWIN_MODAL_APP=showonce-sf3d
TWIN_MODAL_ENVIRONMENT=main
TWIN_DAILY_LIMIT=3
TWIN_TOTAL_LIMIT=10
# Hosted backend only: inject MODAL_TOKEN_ID / MODAL_TOKEN_SECRET through the host's secrets.
# Locally, Modal reads the existing active profile. Never place these tokens in the frontend.
